#!/usr/bin/env bash
set -euo pipefail

# authorized_keys fixes argv[1] to exactly one service and therefore turns the
# Dashboard and Website public keys into non-interchangeable capabilities. The
# GitHub workflow may send either the ordinary immutable release coordinates or
# the single Dashboard-only same-digest Manus v2 rollout capability.
expected_service="${1:-}"
case "$expected_service" in
  dashboard | website) ;;
  *)
    echo "DEPLOY_FIXED_SERVICE_REJECTED" >&2
    exit 64
    ;;
esac
read -r -a words <<<"${SSH_ORIGINAL_COMMAND:-}"
controller_arguments=()
if [[ ${#words[@]} -eq 4 && ${words[0]} == "--kb-manus-v2-rollout" ]]; then
  [[ $expected_service == "dashboard" ]] || {
    echo "PRODUCTION_KB_MANUS_V2_ROLLOUT_SERVICE_REJECTED" >&2
    exit 64
  }
  [[ ${words[1]} =~ ^(dual-read|canary|migration|pause|complete)$ ]] || {
    echo "PRODUCTION_KB_MANUS_V2_ROLLOUT_PHASE_REJECTED" >&2
    exit 64
  }
  image_index=2
  sha_index=3
  controller_arguments=(
    "--kb-manus-v2-rollout" "${words[1]}" "$expected_service"
    "${words[2]}" "${words[3]}"
  )
elif [[ ${#words[@]} -eq 2 ]]; then
  image_index=0
  sha_index=1
  controller_arguments=("$expected_service" "${words[0]}" "${words[1]}")
else
  echo "DEPLOY_COMMAND_REJECTED" >&2
  exit 64
fi
if [[ ! ${words[$image_index]} =~ ^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$ ]]; then
  echo "DEPLOY_IMAGE_REJECTED" >&2
  exit 64
fi
case "$expected_service" in
  dashboard) expected_repository="ghcr.io/xiafanzeng/frontmind-dashboard" ;;
  website) expected_repository="ghcr.io/xiafanzeng/frontmind-website" ;;
esac
[[ ${words[$image_index]} == "${expected_repository}@"* ]] || {
  echo "DEPLOY_IMAGE_REPOSITORY_REJECTED" >&2
  exit 64
}
if [[ ! ${words[$sha_index]} =~ ^[a-f0-9]{40}$ ]]; then
  echo "DEPLOY_SOURCE_SHA_REJECTED" >&2
  exit 64
fi

exec sudo -n /usr/local/sbin/frontmind-deploy-controller \
  "${controller_arguments[@]}"
