# Application
NODE_ENV=production
PORT=3001

# MySQL created in 1Panel. Keep this value server-side only.
DATABASE_URL=mysql://frontmind:replace-with-password@127.0.0.1:3306/frontmind

# Exactly 32 random bytes encoded as base64. Generate once with:
# openssl rand -base64 32
FRONTMIND_CREDENTIAL_ENCRYPTION_KEY=base64:replace-with-32-byte-base64-value

# Optional: override only when using a compatible upstream endpoint.
# FRONTMIND_UPSTREAM_BASE_URL=https://api.example.com

# Optional workflow paths/retention.
# FRONTMIND_WORKFLOW_ROOT=/opt/frontmind/private-workflows/FrontMind_Workflow
# FRONTMIND_KB_SKILL_PATH=/opt/frontmind/private-workflows/socratic-kb-builder.skill
# FRONTMIND_WORKFLOW_UPLOAD_TTL_MS=86400000
# FRONTMIND_EXTERNAL_DOWNLOAD_MAX_BYTES=104857600
# FRONTMIND_PROXY_UPLOAD_MAX_BYTES=104857600
