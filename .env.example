# Application
NODE_ENV=production
PORT=3001

# MySQL created in 1Panel. From a separate Node container, use the exact
# private Docker-network service name (commonly `mysql`), never 127.0.0.1.
DATABASE_URL=mysql://frontmind_dashboard:replace-with-url-encoded-password@mysql:3306/frontmind_dashboard

# Exactly 32 random bytes encoded as base64. Generate once with:
# openssl rand -base64 32
FRONTMIND_CREDENTIAL_ENCRYPTION_KEY=base64:replace-with-32-byte-base64-value

# Shared only with the FrontMind website server. Generate with:
# openssl rand -base64 48
# FRONTMIND_PRESALES_SERVICE_TOKEN=

# Dedicated website-to-Agent token for paid, signed account provisioning.
# Keep it on the two application servers only; never expose it to browsers.
# Generate independently with: openssl rand -base64 48
# FRONTMIND_PROVISIONING_SERVICE_TOKEN=

# Dedicated server-side credential for GEO answer monitoring. This value is
# never returned to the website or browser.
FRONTMIND_MONITOR_API_KEY=

# Canonical browser-facing Agent origin used in setup and workspace links.
# Production requires a real HTTPS URL without credentials, query or fragment.
FRONTMIND_PUBLIC_URL=https://dashboard.frontmind.net
# Canonical website origin used for repeat-purchase and contact links.
FRONTMIND_WEBSITE_URL=https://www.frontmind.net

# Signs short-lived, one-time administrator import preflight credentials for
# dashboard modules and website-content templates. Generate independently and
# keep it server-side only:
# openssl rand -base64 48
FRONTMIND_DASHBOARD_IMPORT_PREFLIGHT_SECRET=
# Optional 60-900 second lifetime. Default: 300.
# FRONTMIND_DASHBOARD_IMPORT_PREFLIGHT_TTL_SECONDS=300

# ICP identity documents use a separate first-party encrypted store. Generate
# an independent 32-byte key and mount the directory on durable private disk:
# openssl rand -base64 32
FRONTMIND_ICP_MATERIAL_KEY=base64:replace-with-independent-32-byte-base64-value
FRONTMIND_ICP_MATERIAL_DIR=/var/lib/frontmind/icp-materials
# Optional retention period, 1-3650 days. Default: 365.
# FRONTMIND_ICP_RETENTION_DAYS=365

# Entitlement rollout defaults to "auto": legacy users keep compatibility
# access while any active user is still in the version-unconfigured queue, and
# enforcement turns on only after that queue reaches zero. Use "enforced" only
# after migration is audited; "compatibility" is an explicit rollback switch.
# FRONTMIND_SERVICE_ENTITLEMENT_ENFORCEMENT=auto

# Optional: override only with an HTTPS endpoint. Credentials, query strings,
# and fragments are rejected; a compatible HTTPS base path is supported.
# FRONTMIND_UPSTREAM_BASE_URL=https://compatible-upstream.your-domain.tld/base
# The monitor override follows the same URL rules; local HTTP is allowed only
# for localhost/loopback development transports.
# FRONTMIND_MONITOR_API_BASE_URL=https://monitor.your-domain.tld/api/base

# Optional dedicated Skill paths. Production overrides must point at the
# immutable artifacts copied by `pnpm build`; an invalid configured path makes
# startup fail closed instead of falling back to a source checkout.
# FRONTMIND_KB_SKILL_PATH=/app/dist/private-workflows/socratic-kb-builder.skill
# FRONTMIND_BRAND_QUESTION_SKILL_PATH=/app/dist/private-workflows/brand-question-portfolio.skill
# FRONTMIND_RESPONSE_LOGIC_SKILL_PATH=/app/dist/private-workflows/response-logic-builder.skill
# Prepared PDFs are streamed and have no fixed per-file size limit.
# FRONTMIND_PREPARED_FILE_DIR=/var/lib/frontmind/prepared-files
# Extracted images from published knowledge-base ZIP files. Mount this path as
# durable storage in production; access remains protected by application auth.
# FRONTMIND_DASHBOARD_ASSET_DIR=/var/lib/frontmind/dashboard-assets
# FRONTMIND_PDF_WORKERS=1
# FRONTMIND_PREPARED_FILE_TTL_MS=2592000000
# FRONTMIND_LARGE_PDF_THRESHOLD_BYTES=67108864
# FRONTMIND_CONVERSATION_RETENTION_DAYS=30
