{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontMind Brand Facts Schema",
  "description": "品牌事实图谱 JSON Schema，由策略层 S1 生成，执行层主线 E0-E5 共享读取。",
  "type": "object",
  "required": ["brand_name", "industry", "positioning", "facts", "metadata"],
  "properties": {
    "brand_name": {
      "type": "string",
      "description": "品牌正式名称"
    },
    "brand_name_en": {
      "type": "string",
      "description": "品牌英文名称"
    },
    "industry": {
      "type": "string",
      "description": "所属行业"
    },
    "sub_industry": {
      "type": "string",
      "description": "细分行业"
    },
    "positioning": {
      "type": "object",
      "description": "品牌定位信息（来自 S4）",
      "required": ["core_value", "target_audience", "differentiator"],
      "properties": {
        "core_value": {
          "type": "string",
          "description": "核心价值主张"
        },
        "target_audience": {
          "type": "array",
          "items": { "type": "string" },
          "description": "目标受众列表"
        },
        "differentiator": {
          "type": "string",
          "description": "差异化优势"
        },
        "brand_promise": {
          "type": "string",
          "description": "品牌承诺"
        }
      }
    },
    "facts": {
      "type": "object",
      "description": "品牌事实数据",
      "properties": {
        "founded_year": { "type": "integer" },
        "headquarters": { "type": "string" },
        "employee_count": { "type": "string" },
        "revenue_range": { "type": "string" },
        "key_products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        },
        "certifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "awards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "year": { "type": "integer" },
              "issuer": { "type": "string" }
            }
          }
        },
        "key_clients": {
          "type": "array",
          "items": { "type": "string" }
        },
        "partnerships": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tone_tokens": {
      "type": "object",
      "description": "话语 Token（来自 S6）",
      "properties": {
        "voice_attributes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_words": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preferred_terms": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "visual_prompts": {
      "type": "object",
      "description": "视觉 Prompt 包（来自 S7）",
      "properties": {
        "color_palette": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "accent": { "type": "string" }
          }
        },
        "style_keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image_style_guide": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["version", "created_by", "created_at"],
      "properties": {
        "version": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "last_modified_at": { "type": "string", "format": "date-time" },
        "last_modified_by": { "type": "string" },
        "revision_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string" },
              "agent": { "type": "string" },
              "change": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
