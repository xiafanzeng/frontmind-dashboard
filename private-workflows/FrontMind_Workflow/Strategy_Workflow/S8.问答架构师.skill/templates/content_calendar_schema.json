{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrontMind Content Calendar Schema",
  "description": "12 周内容日历 JSON 结构定义，用于 S8 问答架构师的产出校验",
  "type": "object",
  "required": ["meta", "weeks"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["brand", "version", "generated_at", "total_weeks", "total_content_items"],
      "properties": {
        "brand": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "total_weeks": { "type": "integer", "minimum": 12, "maximum": 12 },
        "total_content_items": { "type": "integer", "minimum": 12, "description": "至少 12 条内容（每周至少 1 条）" }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["week_number", "theme", "content_items"],
        "properties": {
          "week_number": { "type": "integer", "minimum": 1, "maximum": 12 },
          "theme": { "type": "string", "description": "本周内容主题" },
          "content_items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["item_id", "title", "content_type", "target_platform", "question_stage", "source_question_id"],
              "properties": {
                "item_id": { "type": "string", "pattern": "^W[0-9]{2}-[0-9]{2}$", "description": "如 W01-01" },
                "title": { "type": "string", "description": "内容标题" },
                "content_type": {
                  "type": "string",
                  "enum": ["long_article", "faq", "case_study", "comparison", "whitepaper", "video_script", "social_post"],
                  "description": "内容类型"
                },
                "target_platform": {
                  "type": "string",
                  "enum": ["official_blog", "zhihu", "wechat", "xiaohongshu", "bilibili", "industry_media", "github"],
                  "description": "目标发布平台"
                },
                "question_stage": {
                  "type": "string",
                  "enum": ["awareness", "consideration", "decision", "usage", "advocacy"]
                },
                "source_question_id": { "type": "string", "description": "对应的问答树问题 ID" },
                "verbal_tokens": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "需要注入的 S6 话语 Token"
                },
                "estimated_word_count": { "type": "integer", "description": "预估字数" },
                "priority": {
                  "type": "string",
                  "enum": ["high", "medium", "low"]
                }
              }
            }
          }
        }
      }
    }
  }
}
