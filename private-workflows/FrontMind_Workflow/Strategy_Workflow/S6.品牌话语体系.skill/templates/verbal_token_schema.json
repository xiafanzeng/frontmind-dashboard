{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontMind 话语 Token Schema",
  "description": "S6 品牌话语体系输出的话语 Token JSON 结构定义，供 E2 system-prompt 注入",
  "type": "object",
  "required": ["meta", "tone_tokens", "messaging_house", "high_freq_words", "banned_words", "sentence_patterns", "slogan_candidates", "do_dont_pairs"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["brand", "version", "generated_at", "source_positioning"],
      "properties": {
        "brand": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "generated_at": { "type": "string", "format": "date" },
        "source_positioning": { "type": "string" }
      }
    },
    "tone_tokens": {
      "type": "object",
      "required": ["formal_casual", "serious_funny", "respectful_irreverent", "matter_of_fact_enthusiastic", "tone_description"],
      "properties": {
        "formal_casual": { "type": "integer", "minimum": 1, "maximum": 5 },
        "serious_funny": { "type": "integer", "minimum": 1, "maximum": 5 },
        "respectful_irreverent": { "type": "integer", "minimum": 1, "maximum": 5 },
        "matter_of_fact_enthusiastic": { "type": "integer", "minimum": 1, "maximum": 5 },
        "tone_description": { "type": "string", "minLength": 30 }
      }
    },
    "messaging_house": {
      "type": "object",
      "required": ["core_message", "pillar_1", "pillar_2", "pillar_3", "evidence_bricks"],
      "properties": {
        "core_message": { "type": "string", "minLength": 10 },
        "pillar_1": { "$ref": "#/definitions/pillar" },
        "pillar_2": { "$ref": "#/definitions/pillar" },
        "pillar_3": { "$ref": "#/definitions/pillar" },
        "evidence_bricks": { "type": "array", "items": { "type": "string" }, "minItems": 3 }
      }
    },
    "high_freq_words": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 30
    },
    "banned_words": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 15
    },
    "sentence_patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 10 },
      "minItems": 5
    },
    "slogan_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "scenario", "pillar"],
        "properties": {
          "text": { "type": "string", "minLength": 3 },
          "scenario": { "type": "string" },
          "pillar": { "type": "string" }
        }
      },
      "minItems": 3
    },
    "do_dont_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["do", "dont", "reason"],
        "properties": {
          "do": { "type": "string" },
          "dont": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "minItems": 10
    }
  },
  "definitions": {
    "pillar": {
      "type": "object",
      "required": ["name", "key_points"],
      "properties": {
        "name": { "type": "string" },
        "key_points": { "type": "array", "items": { "type": "string" }, "minItems": 3 }
      }
    }
  }
}
