{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S7 视觉 Prompt 包 v2.6",
  "description": "视觉符号体系输出的视觉 Prompt 包 JSON Schema。v2.6 新增 visual_asset_summary、color_source、reference_assets 等视觉资产锚定字段。",
  "type": "object",
  "required": ["meta", "visual_identity", "visual_motifs"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["brand", "version", "generated_at", "branch", "work_mode", "total_prompts"],
      "properties": {
        "brand": { "type": "string", "description": "品牌名称" },
        "version": { "type": "string", "description": "Prompt 包版本号" },
        "generated_at": { "type": "string", "description": "生成日期" },
        "branch": { "type": "string", "enum": ["A", "B"], "description": "A=现有视觉评估, B=全新设计" },
        "work_mode": {
          "type": "string",
          "enum": ["constrained", "semi_constrained", "inference_only"],
          "description": "v2.6 新增：工作模式。constrained=约束模式（有Logo+配色）, semi_constrained=半约束（仅有配色）, inference_only=纯推导模式"
        },
        "total_prompts": { "type": "integer", "minimum": 3, "maximum": 5, "description": "Prompt 总数" },
        "visual_asset_manifest": { "type": "string", "description": "v2.6 新增：S1 视觉资产清单文件路径" }
      }
    },
    "visual_asset_summary": {
      "type": "object",
      "description": "v2.6 新增：从 S1 视觉资产清单中提取的关键视觉数据摘要，供下游 E3 快速引用",
      "properties": {
        "logo_file": { "type": ["string", "null"], "description": "Logo 文件路径" },
        "logo_colors": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "description": "从 Logo 提取的色值"
        },
        "primary_color": {
          "type": ["string", "null"],
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "推测的品牌主色"
        },
        "dominant_palette": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "description": "综合色板"
        },
        "color_source": {
          "type": "string",
          "enum": ["S1_extracted", "inferred", "mixed"],
          "description": "色彩数据来源"
        },
        "typography_hints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "字体线索"
        },
        "screenshot_homepage": {
          "type": ["string", "null"],
          "description": "官网首页截图路径"
        }
      }
    },
    "visual_identity": {
      "type": "object",
      "required": ["layer_1_symbolic", "layer_2_language", "layer_3_emotion"],
      "description": "三层视觉体系定义",
      "properties": {
        "layer_1_symbolic": {
          "type": "object",
          "required": ["asset_inheritance", "super_sign"],
          "properties": {
            "asset_inheritance": { "type": "string", "description": "资产继承说明（必须引用 S1 留存的真实 Logo 文件路径）" },
            "super_sign": { "type": "string", "description": "视觉符号体系定义" }
          }
        },
        "layer_2_language": {
          "type": "object",
          "required": ["primary_color", "secondary_colors", "accent_color", "composition_preference", "style_keywords"],
          "properties": {
            "primary_color": {
              "oneOf": [
                { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                {
                  "type": "object",
                  "required": ["hex", "source"],
                  "properties": {
                    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "source": { "type": "string", "enum": ["S1_extracted_from_logo", "S1_extracted_from_website", "client_provided", "inferred"] }
                  }
                }
              ],
              "description": "品牌主色（v2.6：建议使用对象格式以标注来源）"
            },
            "secondary_colors": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  {
                    "type": "object",
                    "properties": {
                      "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                      "source": { "type": "string" }
                    }
                  }
                ]
              },
              "description": "辅助色"
            },
            "accent_color": {
              "oneOf": [
                { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                {
                  "type": "object",
                  "properties": {
                    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "source": { "type": "string" }
                  }
                }
              ],
              "description": "点缀色"
            },
            "composition_preference": { "type": "string", "description": "构图偏好" },
            "style_keywords": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3,
              "maxItems": 10,
              "description": "风格关键词"
            }
          }
        },
        "layer_3_emotion": {
          "type": "object",
          "required": ["core_vibe"],
          "properties": {
            "core_vibe": { "type": "string", "description": "核心情感调性" }
          }
        }
      }
    },
    "visual_motifs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "核心视觉母题 Prompt 列表",
      "items": {
        "type": "object",
        "required": ["motif_id", "motif_type", "positive_prompt", "style_keywords", "color_hex", "color_source", "composition", "negative_prompt", "reference_assets"],
        "properties": {
          "motif_id": { "type": "string", "description": "母题唯一标识" },
          "motif_type": {
            "type": "string",
            "enum": ["符号化识别演绎", "核心业务场景", "品牌情感意境"],
            "description": "母题类型"
          },
          "positive_prompt": { "type": "string", "minLength": 50, "description": "正面描述（英文，不少于 50 字符）" },
          "style_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "description": "风格关键词"
          },
          "color_hex": {
            "type": "array",
            "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "minItems": 1,
            "description": "色彩约束 hex 值列表"
          },
          "color_source": {
            "type": "string",
            "enum": ["S1_extracted", "inferred", "mixed"],
            "description": "v2.6 新增：色彩来源标注"
          },
          "composition": { "type": "string", "description": "构图规则" },
          "negative_prompt": { "type": "string", "description": "负面词" },
          "reference_assets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "v2.6 新增：引用的 S1 视觉资产文件路径列表"
          },
          "img2img_reference": {
            "type": ["string", "null"],
            "description": "v2.6 新增：图生图/垫图参考文件路径（供 E3 使用 ControlNet/IP-Adapter）"
          },
          "aspect_ratio": { "type": "string", "description": "宽高比" },
          "recommended_tool": {
            "type": "string",
            "enum": ["Midjourney", "Flux.1", "SDXL", "Lovart", "即梦"],
            "description": "推荐 AI 绘画工具"
          },
          "tool_specific_params": { "type": "string", "description": "工具特定参数后缀" },
          "category": { "type": "string" },
          "usage_scenario": { "type": "string", "description": "使用场景" }
        }
      }
    }
  }
}
