{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontMind 品牌事实图谱 v2.6",
  "description": "三段式品牌事实图谱 JSON Schema。v2.6 新增 brand_assets 中的视觉资产留存字段。",
  "type": "object",
  "required": ["facts", "claims", "evidence"],
  "properties": {
    "facts": {
      "type": "object",
      "description": "硬事实集合，包含 12 个维度子对象",
      "properties": {
        "company_info": {
          "type": "object",
          "description": "D01 企业基础信息",
          "required": ["full_name", "short_name", "industry"],
          "properties": {
            "full_name": { "type": "string", "description": "企业全称" },
            "short_name": { "type": "string", "description": "品牌简称" },
            "english_name": { "type": "string", "description": "英文名称" },
            "established_date": { "type": "string", "description": "成立日期（ISO 8601）" },
            "registered_capital": { "type": "string", "description": "注册资本" },
            "legal_representative": { "type": "string", "description": "法定代表人" },
            "headquarters": { "type": "string", "description": "总部地址" },
            "branch_offices": { "type": "array", "items": { "type": "string" }, "description": "分支机构" },
            "industry": { "type": "string", "description": "所属行业" },
            "sub_industry": { "type": "string", "description": "细分行业" },
            "company_type": { "type": "string", "description": "企业类型" },
            "website_url": { "type": "string", "format": "uri", "description": "官网地址" },
            "social_media": { "type": "object", "description": "社交媒体账号" }
          }
        },
        "team": {
          "type": "object",
          "description": "D02 团队信息",
          "properties": {
            "total_employees": { "type": "integer" },
            "rd_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "founder": { "type": "object", "description": "创始人信息" },
            "core_team": { "type": "array", "items": { "type": "object" } },
            "org_structure": { "type": "string" }
          }
        },
        "products": {
          "type": "array",
          "description": "D03 产品/服务矩阵",
          "items": {
            "type": "object",
            "required": ["name", "category", "description"],
            "properties": {
              "name": { "type": "string" },
              "category": { "type": "string" },
              "description": { "type": "string" },
              "price_range": { "type": "string" },
              "key_params": { "type": "array", "items": { "type": "string" } },
              "target_clients": { "type": "array", "items": { "type": "string" } },
              "lifecycle_stage": { "type": "string" },
              "revenue_share": { "type": "number" }
            }
          }
        },
        "technology": {
          "type": "object",
          "description": "D04 技术能力",
          "properties": {
            "core_technologies": { "type": "array", "items": { "type": "string" } },
            "patents": { "type": "array", "items": { "type": "object" } },
            "patent_count": { "type": "integer" },
            "rd_investment": { "type": "string" },
            "tech_barriers": { "type": "array", "items": { "type": "string" } },
            "lab_equipment": { "type": "array", "items": { "type": "string" } }
          }
        },
        "clients": {
          "type": "object",
          "description": "D05 客户信息",
          "required": ["target_segments"],
          "properties": {
            "target_segments": { "type": "array", "items": { "type": "string" } },
            "total_clients": { "type": "integer" },
            "key_accounts": { "type": "array", "items": { "type": "object" } },
            "retention_rate": { "type": "number" },
            "nps_score": { "type": "number" }
          }
        },
        "certifications": {
          "type": "array",
          "description": "D06 资质认证",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "number": { "type": "string" },
              "issuer": { "type": "string" },
              "valid_until": { "type": "string" },
              "scope": { "type": "string" }
            }
          }
        },
        "financials": {
          "type": "object",
          "description": "D07 财务数据",
          "properties": {
            "annual_revenue": { "type": "string" },
            "revenue_growth": { "type": "number" },
            "profit_margin": { "type": "number" },
            "funding_rounds": { "type": "array", "items": { "type": "object" } },
            "valuation": { "type": "string" }
          }
        },
        "competition": {
          "type": "object",
          "description": "D08 竞争格局",
          "properties": {
            "direct_competitors": { "type": "array", "items": { "type": "object" } },
            "indirect_competitors": { "type": "array", "items": { "type": "object" } },
            "market_share": { "type": "string" },
            "competitive_advantages": { "type": "array", "items": { "type": "string" } }
          }
        },
        "market": {
          "type": "object",
          "description": "D09 市场信息",
          "properties": {
            "market_size": { "type": "string" },
            "growth_rate": { "type": "string" },
            "target_segment": { "type": "string" },
            "coverage_region": { "type": "string" }
          }
        },
        "brand_assets": {
          "type": "object",
          "description": "D10 品牌视觉资产（v2.6 重大升级：新增视觉资产留存字段）",
          "properties": {
            "brand_story": { "type": "string", "description": "品牌故事" },
            "name_meaning": { "type": "string", "description": "品牌名称含义" },
            "logo_description": { "type": "string", "description": "Logo 文字描述" },
            "brand_colors": {
              "type": "object",
              "description": "品牌色彩体系（含 hex 值和来源标注）",
              "properties": {
                "primary": {
                  "type": "object",
                  "properties": {
                    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "source": { "type": "string", "enum": ["client_provided", "extracted_from_logo", "extracted_from_website", "vi_manual"] }
                  }
                },
                "secondary": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                      "source": { "type": "string" }
                    }
                  }
                },
                "accent": {
                  "type": "object",
                  "properties": {
                    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "source": { "type": "string" }
                  }
                }
              }
            },
            "slogans": { "type": "array", "items": { "type": "string" }, "description": "品牌口号" },
            "personality_keywords": { "type": "array", "items": { "type": "string" }, "description": "品牌人格关键词" },
            "visual_asset_manifest": {
              "type": "string",
              "description": "v2.6 新增：视觉资产清单 JSON 文件路径（S1_{brand}_视觉资产清单.json）"
            },
            "retained_files": {
              "type": "array",
              "description": "v2.6 新增：已留存的视觉资产文件列表（Logo/Favicon/截图等物理文件的结构化元数据）",
              "items": {
                "type": "object",
                "required": ["asset_id", "asset_type", "local_path", "provided_by"],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "description": "资产唯一标识符，如 logo_001、favicon_002"
                  },
                  "asset_type": {
                    "type": "string",
                    "enum": ["logo", "favicon", "og_image", "banner", "screenshot", "vi_manual", "brand_material", "client_upload"],
                    "description": "资产类型"
                  },
                  "local_path": {
                    "type": "string",
                    "description": "本地文件路径（相对于工作目录）"
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "资产来源 URL（抓取时记录）"
                  },
                  "file_hash": {
                    "type": "string",
                    "description": "文件 SHA256 哈希（sha256:前缀）"
                  },
                  "dimensions": {
                    "type": "object",
                    "properties": {
                      "width": { "type": "integer" },
                      "height": { "type": "integer" }
                    },
                    "description": "图片尺寸"
                  },
                  "extracted_colors": {
                    "type": "array",
                    "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "description": "从该文件提取的主色调 hex 列表"
                  },
                  "provided_by": {
                    "type": "string",
                    "enum": ["client", "scraper", "browser_screenshot"],
                    "description": "资产来源方式"
                  }
                }
              }
            },
            "extracted_palette": {
              "type": "object",
              "description": "v2.6 新增：从 Logo 和官网提取的色彩数据",
              "properties": {
                "from_logo": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "description": "从 Logo 文件提取的色值"
                },
                "from_website": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                      "frequency": { "type": "integer" }
                    }
                  },
                  "description": "从官网 CSS 提取的高频色值"
                },
                "dominant_colors": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "description": "综合推测的品牌主色调列表"
                },
                "primary_color_guess": {
                  "type": ["string", "null"],
                  "pattern": "^#[0-9A-Fa-f]{6}$",
                  "description": "推测的品牌主色"
                }
              }
            },
            "typography": {
              "type": "object",
              "description": "v2.6 新增：字体线索",
              "properties": {
                "from_css": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "从官网 CSS font-family 提取的字体名称"
                },
                "from_vi_manual": {
                  "type": ["object", "null"],
                  "properties": {
                    "chinese": { "type": "string" },
                    "english": { "type": "string" }
                  },
                  "description": "从 VI 手册中获取的标准字体"
                },
                "client_specified": {
                  "type": ["string", "null"],
                  "description": "客户明确指定的字体"
                }
              }
            }
          }
        },
        "public_intelligence": {
          "type": ["object", "null"],
          "description": "D13 公共情报（v2.7 新增：本地生活类业务强制采集，其他行业可选）",
          "properties": {
            "industry_trigger": { "type": "string", "description": "触发采集的行业属性" },
            "platforms_scanned": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "platform": { "type": "string" },
                  "url": { "type": "string", "format": "uri" },
                  "rating": { "type": "number", "minimum": 0, "maximum": 5 },
                  "review_count": { "type": "integer" },
                  "scan_date": { "type": "string" }
                }
              }
            },
            "rating_summary": {
              "type": "object",
              "properties": {
                "average_score": { "type": "number" },
                "total_reviews": { "type": "integer" },
                "score_distribution": { "type": "object" }
              }
            },
            "positive_themes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "theme": { "type": "string" },
                  "frequency": { "type": "integer" },
                  "sample_quote": { "type": "string" }
                }
              }
            },
            "negative_themes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "theme": { "type": "string" },
                  "frequency": { "type": "integer" },
                  "sample_quote": { "type": "string" }
                }
              }
            },
            "storefront_images": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "local_path": { "type": "string" },
                  "source_url": { "type": "string" },
                  "source_platform": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "poi_info": {
              "type": "object",
              "properties": {
                "address": { "type": "string" },
                "coordinates": {
                  "type": "object",
                  "properties": {
                    "lat": { "type": "number" },
                    "lng": { "type": "number" }
                  }
                },
                "nearby_landmarks": { "type": "array", "items": { "type": "string" } },
                "transport": { "type": "string" }
              }
            },
            "competitive_context": {
              "type": "object",
              "properties": {
                "nearby_competitors": { "type": "array", "items": { "type": "string" } },
                "price_positioning": { "type": "string" }
              }
            },
            "raw_reviews": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "platform": { "type": "string" },
                  "rating": { "type": "number" },
                  "text": { "type": "string" },
                  "date": { "type": "string" },
                  "sentiment": { "type": "string", "enum": ["positive", "negative", "neutral"] }
                }
              }
            }
          }
        },
        "channels": {
          "type": "object",
          "description": "D11 渠道信息",
          "properties": {
            "online_channels": { "type": "array", "items": { "type": "string" } },
            "offline_channels": { "type": "array", "items": { "type": "string" } },
            "channel_distribution": { "type": "object" }
          }
        },
        "intent": {
          "type": "object",
          "description": "D12 战略意图",
          "required": ["strategic_goals"],
          "properties": {
            "strategic_goals": { "type": "array", "items": { "type": "string" } },
            "cooperation_expectations": { "type": "string" },
            "budget_range": { "type": "string" },
            "timeline": { "type": "string" }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "description": "品牌主张集合",
      "required": ["positioning", "differentiators"],
      "properties": {
        "positioning": { "type": "string", "description": "品牌定位主张" },
        "value_proposition": { "type": "string", "description": "价值主张" },
        "differentiators": { "type": "array", "items": { "type": "string" }, "description": "差异化宣称" },
        "slogans": { "type": "array", "items": { "type": "string" }, "description": "品牌口号" },
        "brand_personality": { "type": "array", "items": { "type": "string" }, "description": "品牌人格" },
        "mission": { "type": "string", "description": "品牌使命" },
        "vision": { "type": "string", "description": "品牌愿景" }
      }
    },
    "evidence": {
      "type": "array",
      "description": "证据链数组",
      "items": {
        "type": "object",
        "required": ["claim_ref", "source_type", "confidence"],
        "properties": {
          "claim_ref": { "type": "string", "description": "关联的 claim 路径" },
          "source_url": { "type": "string", "description": "来源 URL" },
          "source_type": {
            "type": "string",
            "enum": ["official_document", "official_website", "media_report", "client_statement", "ai_inference", "visual_asset_extraction", "third_party_platform", "map_poi", "user_review"],
            "description": "来源类型（v2.6 新增 visual_asset_extraction）"
          },
          "timestamp": { "type": "string", "description": "信息获取时间" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "置信度（0-1）" },
          "excerpt": { "type": "string", "description": "原文摘录" }
        }
      }
    }
  }
}
