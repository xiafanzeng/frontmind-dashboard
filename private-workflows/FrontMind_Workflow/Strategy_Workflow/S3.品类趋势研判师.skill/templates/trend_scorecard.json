{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontMind 趋势打分卡 Schema",
  "description": "S3 品类趋势研判师输出的趋势打分卡 JSON 结构定义",
  "type": "object",
  "required": ["meta", "trends", "opportunity_map"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["brand", "category", "created_at", "trend_count"],
      "properties": {
        "brand": { "type": "string", "description": "品牌简称" },
        "category": { "type": "string", "description": "主品类" },
        "sub_category": { "type": "string", "description": "细分品类" },
        "created_at": { "type": "string", "format": "date", "description": "生成日期" },
        "trend_count": { "type": "integer", "minimum": 8, "description": "趋势条目总数" },
        "weak_signal_count": { "type": "integer", "minimum": 1, "description": "文化弱信号数" }
      }
    },
    "trends": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "lifecycle_stage", "scores", "total_score", "signals", "opportunity", "time_windows"],
        "properties": {
          "id": { "type": "string", "pattern": "^TR[0-9]{3}$", "description": "趋势编号" },
          "name": { "type": "string", "description": "趋势名称" },
          "category": {
            "type": "string",
            "enum": ["macro", "technology", "consumer", "policy", "cultural_weak_signal"],
            "description": "趋势类型"
          },
          "lifecycle_stage": {
            "type": "string",
            "enum": ["emerging", "growth", "mature", "declining"],
            "description": "品类生命周期阶段"
          },
          "scores": {
            "type": "object",
            "required": ["maturity", "growth_rate", "brand_fit", "time_window", "competitive_gap"],
            "properties": {
              "maturity": { "type": "number", "minimum": 0, "maximum": 10 },
              "growth_rate": { "type": "number", "minimum": 0, "maximum": 10 },
              "brand_fit": { "type": "number", "minimum": 0, "maximum": 10 },
              "time_window": { "type": "number", "minimum": 0, "maximum": 10 },
              "competitive_gap": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          },
          "total_score": { "type": "number", "minimum": 0, "maximum": 10, "description": "加权总分" },
          "signals": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["source", "url", "timestamp", "description"],
              "properties": {
                "source": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "timestamp": { "type": "string", "format": "date" },
                "description": { "type": "string" }
              }
            }
          },
          "opportunity": { "type": "string", "description": "机会描述" },
          "time_windows": {
            "type": "object",
            "required": ["3_month", "6_month", "12_month"],
            "properties": {
              "3_month": { "type": "string" },
              "6_month": { "type": "string" },
              "12_month": { "type": "string" }
            }
          }
        }
      }
    },
    "opportunity_map": {
      "type": "object",
      "description": "机会地图：趋势 × 品牌契合度矩阵",
      "required": ["high_priority", "medium_priority", "low_priority"],
      "properties": {
        "high_priority": {
          "type": "array",
          "items": { "type": "string", "description": "趋势 ID" }
        },
        "medium_priority": {
          "type": "array",
          "items": { "type": "string" }
        },
        "low_priority": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
